EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=powiat-decyduje.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=powiat-decyduje
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=powiat-decyduje.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Google Maps (wymagane dla mapy na Androidzie/iOS)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Local development with Firebase emulators
EXPO_PUBLIC_USE_FUNCTIONS_EMULATOR=false
EXPO_PUBLIC_FUNCTIONS_EMULATOR_HOST=

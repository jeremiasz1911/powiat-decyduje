# Admin login (server-side only — never expose ADMIN_PASSWORD to the client)
ADMIN_USERNAME=admin_powiat
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Firebase Admin SDK (service account)
FIREBASE_ADMIN_PROJECT_ID=powiat-decyduje
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@powiat-decyduje.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Maps (for admin map view — optional, same key as mobile app)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

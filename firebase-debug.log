[debug] [2026-05-17T17:24:25.324Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/powiat-decyduje/rulesets {"name":"projects/powiat-decyduje/rulesets/7b8970dc-2742-45d8-94a4-daaab71a8fa3","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function isOwner(uid) {\n      return isSignedIn() && request.auth.uid == uid;\n    }\n\n    function userVoteDoc(projectId, uid) {\n      return /databases/$(database)/documents/projects/$(projectId)/votes/$(uid);\n    }\n\n    function validProjectCreate() {\n      return request.resource.data.keys().hasOnly([\n        'title',\n        'description',\n        'category',\n        'locationLabel',\n        'commune',\n        'village',\n        'cost',\n        'location',\n        'icon',\n        'imageUrl',\n        'imageUrls',\n        'createdBy',\n        'createdByResidentAccountId',\n        'createdByResidentPesel',\n        'createdByResidentLabel',\n        'createdAt',\n        'status',\n        'votesCount'\n      ]) &&\n      request.resource.data.createdBy == request.auth.uid &&\n      request.resource.data.createdByResidentAccountId is string &&\n      request.resource.data.createdByResidentPesel is string &&\n      request.resource.data.createdByResidentLabel is string &&\n      request.resource.data.icon is string &&\n      request.resource.data.status == 'submitted' &&\n      request.resource.data.votesCount == 0;\n    }\n\n    match /projects/{projectId} {\n      // Public projects list/details.\n      allow get, list: if true;\n\n      // Authenticated user can submit only their own project.\n      allow create: if isSignedIn() && validProjectCreate();\n\n      // votesCount can only be incremented by exactly 1 and only\n      // when a new vote document for this user is created in the same write.\n      allow update: if isSignedIn() &&\n        (\n          (\n            request.resource.data.diff(resource.data).changedKeys().hasOnly(['votesCount']) &&\n            request.resource.data.votesCount == resource.data.votesCount + 1 &&\n            !exists(userVoteDoc(projectId, request.auth.uid)) &&\n            existsAfter(userVoteDoc(projectId, request.auth.uid))\n          ) ||\n          (\n            resource.data.createdBy == request.auth.uid &&\n            request.resource.data.diff(resource.data).changedKeys().hasOnly([\n              'title',\n              'description',\n              'category',\n              'locationLabel',\n              'commune',\n              'village',\n              'cost',\n              'location',\n              'icon',\n              'updatedAt'\n            ]) &&\n            request.resource.data.updatedAt == request.time &&\n            request.resource.data.createdBy == resource.data.createdBy &&\n            request.resource.data.votesCount == resource.data.votesCount &&\n            request.resource.data.status == resource.data.status &&\n            request.resource.data.imageUrl == resource.data.imageUrl &&\n            request.resource.data.imageUrls == resource.data.imageUrls &&\n            request.resource.data.icon is string &&\n            request.resource.data.createdAt == resource.data.createdAt\n          )\n        );\n\n      allow delete: if false;\n\n      match /votes/{uid} {\n        allow read: if isOwner(uid);\n\n        allow create: if isOwner(uid) &&\n          !exists(userVoteDoc(projectId, uid)) &&\n          request.resource.data.keys().hasOnly(['userId', 'installationId', 'createdAt']) &&\n          request.resource.data.userId == request.auth.uid &&\n          request.resource.data.installationId is string &&\n          request.resource.data.installationId.size() >= 8 &&\n          request.resource.data.createdAt == request.time;\n\n        allow update, delete: if false;\n      }\n\n      match /installationVotes/{installationId} {\n        // vote transaction reads this doc to prevent duplicate votes per installation\n        allow get: if isSignedIn();\n        allow list: if false;\n\n        allow create: if isSignedIn() &&\n          !exists(/databases/$(database)/documents/projects/$(projectId)/installationVotes/$(installationId)) &&\n          request.resource.data.keys().hasOnly(['userId', 'installationId', 'createdAt']) &&\n          request.resource.data.userId == request.auth.uid &&\n          request.resource.data.installationId == installationId &&\n          installationId.size() >= 8 &&\n          request.resource.data.createdAt == request.time;\n\n        allow update, delete: if false;\n      }\n    }\n\n    match /users/{uid} {\n      allow read: if isOwner(uid);\n      allow create, update: if isOwner(uid) &&\n        request.resource.data.keys().hasOnly([\n          'uid',\n          'firstName',\n          'lastName',\n          'fullName',\n          'email',\n          'phoneNumber',\n          'pesel',\n          'address',\n          'commune',\n          'county',\n          'residentStatus',\n          'phoneVerified',\n          'emailVerified',\n          'consents',\n          'residentAccounts',\n          'activeResidentAccountId',\n          'createdAt',\n          'updatedAt'\n        ]) &&\n        request.resource.data.uid == uid &&\n        request.resource.data.residentStatus == 'verified_resident' &&\n        request.resource.data.phoneVerified is bool &&\n        request.resource.data.emailVerified is bool &&\n        request.resource.data.residentAccounts is list &&\n        request.resource.data.residentAccounts.size() <= 5 &&\n        request.resource.data.commune is string &&\n        request.resource.data.county is string &&\n        request.resource.data.updatedAt == request.time;\n\n      allow delete: if false;\n    }\n\n    match /auth_index_phone/{phoneNumber} {\n      allow get: if isSignedIn();\n      allow list: if false;\n      allow create, update: if isSignedIn() &&\n        request.resource.data.keys().hasOnly([\n          'normalizedPhoneNumber',\n          'uid',\n          'uids',\n          'residentAccountIds',\n          'accountCount',\n          'createdAt',\n          'updatedAt'\n        ]) &&\n        request.resource.data.normalizedPhoneNumber == phoneNumber &&\n        request.resource.data.uid == request.auth.uid &&\n        request.resource.data.uids is list &&\n        request.resource.data.residentAccountIds is list &&\n        request.resource.data.accountCount is int &&\n        request.resource.data.accountCount >= 0 &&\n        request.resource.data.accountCount <= 5 &&\n        request.resource.data.updatedAt == request.time;\n      allow delete: if false;\n    }\n\n    match /auth_index_pesel/{pesel} {\n      allow get: if isSignedIn();\n      allow list: if false;\n      allow create, update: if isSignedIn() &&\n        request.resource.data.keys().hasOnly([\n          'pesel',\n          'uid',\n          'residentAccountId',\n          'createdAt',\n          'updatedAt'\n        ]) &&\n        request.resource.data.pesel == pesel &&\n        request.resource.data.uid == request.auth.uid &&\n        request.resource.data.updatedAt == request.time;\n      allow delete: if false;\n    }\n\n    match /sms_rate_limits/{normalizedPhoneNumber} {\n      allow get: if isSignedIn();\n      allow list: if false;\n      allow create, update: if isSignedIn() &&\n        request.resource.data.keys().hasOnly([\n          'blockedUntil',\n          'lastSmsTime',\n          'smsCount5Min',\n          'smsCountDay',\n          'dayResets',\n          'createdAt',\n          'updatedAt'\n        ]) &&\n        request.resource.data.lastSmsTime is int &&\n        request.resource.data.smsCount5Min is int &&\n        request.resource.data.smsCountDay is int &&\n        request.resource.data.dayResets is int &&\n        request.resource.data.updatedAt == request.time;\n      allow delete: if false;\n    }\n\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-05-17T17:24:25.286991Z","metadata":{"services":["cloud.firestore"]}}

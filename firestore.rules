rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function projectAuthorId(data) {
      return data.authorId != null && data.authorId is string && data.authorId.size() > 0
        ? data.authorId
        : data.createdBy;
    }

    function isProjectAuthor(data) {
      return isSignedIn() && (
        data.createdBy == request.auth.uid ||
        (data.authorId != null && data.authorId is string && data.authorId == request.auth.uid)
      );
    }

    function isApprovedProject(data) {
      return data.status == 'approved';
    }

    function canReadProject(data) {
      return isApprovedProject(data) || isProjectAuthor(data);
    }

    function userVoteDoc(projectId, uid) {
      return /databases/$(database)/documents/projects/$(projectId)/votes/$(uid);
    }

    function validProjectCreate() {
      return request.resource.data.keys().hasOnly([
        'title',
        'description',
        'category',
        'locationLabel',
        'commune',
        'village',
        'cost',
        'location',
        'icon',
        'imageUrl',
        'imageUrls',
        'markerColor',
        'authorId',
        'createdBy',
        'createdByResidentAccountId',
        'createdByResidentPesel',
        'createdByResidentLabel',
        'createdAt',
        'updatedAt',
        'status',
        'votesCount'
      ]) &&
      request.resource.data.authorId == request.auth.uid &&
      request.resource.data.createdBy == request.auth.uid &&
      request.resource.data.createdByResidentAccountId is string &&
      request.resource.data.createdByResidentPesel is string &&
      request.resource.data.createdByResidentLabel is string &&
      request.resource.data.icon is string &&
      request.resource.data.status == 'submitted' &&
      request.resource.data.votesCount == 0;
    }

    function validProjectOwnerUpdate() {
      return resource.data.status == 'submitted' &&
        isProjectAuthor(resource.data) &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'title',
          'description',
          'category',
          'locationLabel',
          'commune',
          'village',
          'cost',
          'location',
          'icon',
          'markerColor',
          'updatedAt'
        ]) &&
        request.resource.data.updatedAt == request.time &&
        projectAuthorId(request.resource.data) == projectAuthorId(resource.data) &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.votesCount == resource.data.votesCount &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.imageUrl == resource.data.imageUrl &&
        request.resource.data.imageUrls == resource.data.imageUrls &&
        request.resource.data.icon is string &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    function validVoteCountUpdate(projectId) {
      return isSignedIn() &&
        isApprovedProject(resource.data) &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['votesCount']) &&
        request.resource.data.votesCount == resource.data.votesCount + 1 &&
        !exists(userVoteDoc(projectId, request.auth.uid)) &&
        existsAfter(userVoteDoc(projectId, request.auth.uid));
    }

    match /projects/{projectId} {
      allow get: if canReadProject(resource.data);

      // Osobne reguły list — Firestore wymaga zgodności zapytania z regułami (bez OR w jednej regule).
      allow list: if resource.data.status == 'approved';
      allow list: if isSignedIn() && resource.data.createdBy == request.auth.uid;
      allow list: if isSignedIn() &&
        resource.data.authorId != null &&
        resource.data.authorId is string &&
        resource.data.authorId == request.auth.uid;

      allow create: if isSignedIn() && validProjectCreate();

      allow update: if isSignedIn() && (validVoteCountUpdate(projectId) || validProjectOwnerUpdate());

      allow delete: if false;

      match /votes/{uid} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid) &&
          get(/databases/$(database)/documents/projects/$(projectId)).data.status == 'approved' &&
          !exists(userVoteDoc(projectId, uid)) &&
          request.resource.data.keys().hasOnly(['userId', 'installationId', 'createdAt', 'isAnonymous']) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.installationId is string &&
          request.resource.data.installationId.size() >= 8 &&
          request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }

      match /installationVotes/{installationId} {
        allow get: if isSignedIn();
        allow list: if false;

        allow create: if isSignedIn() &&
          get(/databases/$(database)/documents/projects/$(projectId)).data.status == 'approved' &&
          !exists(/databases/$(database)/documents/projects/$(projectId)/installationVotes/$(installationId)) &&
          request.resource.data.keys().hasOnly(['userId', 'installationId', 'createdAt', 'isAnonymous']) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.installationId == installationId &&
          installationId.size() >= 8 &&
          request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) &&
        request.resource.data.keys().hasOnly([
          'uid',
          'firstName',
          'lastName',
          'fullName',
          'email',
          'phoneNumber',
          'pesel',
          'address',
          'commune',
          'county',
          'residentStatus',
          'phoneVerified',
          'emailVerified',
          'consents',
          'residentAccounts',
          'activeResidentAccountId',
          'votesUsed',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.uid == uid &&
        request.resource.data.residentStatus == 'verified_resident' &&
        request.resource.data.phoneVerified is bool &&
        request.resource.data.emailVerified is bool &&
        request.resource.data.residentAccounts is list &&
        request.resource.data.residentAccounts.size() <= 5 &&
        request.resource.data.commune is string &&
        request.resource.data.county is string &&
        request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /auth_index_phone/{phoneNumber} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update: if isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'normalizedPhoneNumber',
          'uid',
          'uids',
          'residentAccountIds',
          'accountCount',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.normalizedPhoneNumber == phoneNumber &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.uids is list &&
        request.resource.data.residentAccountIds is list &&
        request.resource.data.accountCount is int &&
        request.resource.data.accountCount >= 0 &&
        request.resource.data.accountCount <= 5 &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(request.resource.data.uid);
    }

    match /auth_index_pesel/{pesel} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update: if isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'pesel',
          'uid',
          'residentAccountId',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.pesel == pesel &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(request.resource.data.uid);
    }

    match /sms_rate_limits/{normalizedPhoneNumber} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update: if isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'blockedUntil',
          'lastSmsTime',
          'smsCount5Min',
          'smsCountDay',
          'dayResets',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.lastSmsTime is int &&
        request.resource.data.smsCount5Min is int &&
        request.resource.data.smsCountDay is int &&
        request.resource.data.dayResets is int &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /app_settings/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /sms_logs/{logId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

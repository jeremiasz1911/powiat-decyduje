rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userVoteDoc(projectId, uid) {
      return /databases/$(database)/documents/projects/$(projectId)/votes/$(uid);
    }

    function validProjectCreate() {
      return request.resource.data.keys().hasOnly([
        'title',
        'description',
        'category',
        'locationLabel',
        'commune',
        'village',
        'cost',
        'location',
        'icon',
        'imageUrl',
        'imageUrls',
        'createdBy',
        'createdByResidentAccountId',
        'createdByResidentPesel',
        'createdByResidentLabel',
        'createdAt',
        'status',
        'votesCount'
      ]) &&
      request.resource.data.createdBy == request.auth.uid &&
      request.resource.data.createdByResidentAccountId is string &&
      request.resource.data.createdByResidentPesel is string &&
      request.resource.data.createdByResidentLabel is string &&
      request.resource.data.icon is string &&
      request.resource.data.status == 'submitted' &&
      request.resource.data.votesCount == 0;
    }

    match /projects/{projectId} {
      // Public projects list/details.
      allow get, list: if true;

      // Authenticated user can submit only their own project.
      allow create: if isSignedIn() && validProjectCreate();

      // votesCount can only be incremented by exactly 1 and only
      // when a new vote document for this user is created in the same write.
      allow update: if isSignedIn() &&
        (
          (
            request.resource.data.diff(resource.data).changedKeys().hasOnly(['votesCount']) &&
            request.resource.data.votesCount == resource.data.votesCount + 1 &&
            !exists(userVoteDoc(projectId, request.auth.uid)) &&
            existsAfter(userVoteDoc(projectId, request.auth.uid))
          ) ||
          (
            resource.data.createdBy == request.auth.uid &&
            request.resource.data.diff(resource.data).changedKeys().hasOnly([
              'title',
              'description',
              'category',
              'locationLabel',
              'commune',
              'village',
              'cost',
              'location',
              'icon',
              'updatedAt'
            ]) &&
            request.resource.data.updatedAt == request.time &&
            request.resource.data.createdBy == resource.data.createdBy &&
            request.resource.data.votesCount == resource.data.votesCount &&
            request.resource.data.status == resource.data.status &&
            request.resource.data.imageUrl == resource.data.imageUrl &&
            request.resource.data.imageUrls == resource.data.imageUrls &&
            request.resource.data.icon is string &&
            request.resource.data.createdAt == resource.data.createdAt
          )
        );

      allow delete: if false;

      match /votes/{uid} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid) &&
          !exists(userVoteDoc(projectId, uid)) &&
          request.resource.data.keys().hasOnly(['userId', 'installationId', 'createdAt']) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.installationId is string &&
          request.resource.data.installationId.size() >= 8 &&
          request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }

      match /installationVotes/{installationId} {
        // vote transaction reads this doc to prevent duplicate votes per installation
        allow get: if isSignedIn();
        allow list: if false;

        allow create: if isSignedIn() &&
          !exists(/databases/$(database)/documents/projects/$(projectId)/installationVotes/$(installationId)) &&
          request.resource.data.keys().hasOnly(['userId', 'installationId', 'createdAt']) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.installationId == installationId &&
          installationId.size() >= 8 &&
          request.resource.data.createdAt == request.time;

        allow update, delete: if false;
      }
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) &&
        request.resource.data.keys().hasOnly([
          'uid',
          'firstName',
          'lastName',
          'fullName',
          'email',
          'phoneNumber',
          'pesel',
          'address',
          'commune',
          'county',
          'residentStatus',
          'phoneVerified',
          'emailVerified',
          'consents',
          'residentAccounts',
          'activeResidentAccountId',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.uid == uid &&
        request.resource.data.residentStatus == 'verified_resident' &&
        request.resource.data.phoneVerified is bool &&
        request.resource.data.emailVerified is bool &&
        request.resource.data.residentAccounts is list &&
        request.resource.data.residentAccounts.size() <= 5 &&
        request.resource.data.commune is string &&
        request.resource.data.county is string &&
        request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /auth_index_phone/{phoneNumber} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update: if isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'normalizedPhoneNumber',
          'uid',
          'uids',
          'residentAccountIds',
          'accountCount',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.normalizedPhoneNumber == phoneNumber &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.uids is list &&
        request.resource.data.residentAccountIds is list &&
        request.resource.data.accountCount is int &&
        request.resource.data.accountCount >= 0 &&
        request.resource.data.accountCount <= 5 &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /auth_index_pesel/{pesel} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update: if isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'pesel',
          'uid',
          'residentAccountId',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.pesel == pesel &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /sms_rate_limits/{normalizedPhoneNumber} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update: if isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'blockedUntil',
          'lastSmsTime',
          'smsCount5Min',
          'smsCountDay',
          'dayResets',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.lastSmsTime is int &&
        request.resource.data.smsCount5Min is int &&
        request.resource.data.smsCountDay is int &&
        request.resource.data.dayResets is int &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

{
  "name": "powiat-decyduje",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "seed:test-resident": "node ./scripts/seed-test-resident.js",
    "migrate:project-statuses": "node ./scripts/migrate-project-statuses.js",
    "android": "expo run:android",
    "android:sha1": "bash scripts/android-debug-sha1.sh",
    "eas:env:production": "bash scripts/eas-push-production-env.sh",
    "eas:build:ios": "eas build --platform ios --profile production",
    "eas:submit:ios": "eas submit --platform ios --profile production --latest",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck",
    "functions:build": "npm --prefix functions run build",
    "functions:deploy": "firebase deploy --only functions",
    "storage:deploy": "firebase deploy --only storage",
    "functions:list": "firebase functions:list",
    "emulators:start": "npm run functions:build && firebase emulators:start --only functions,firestore",
    "build:android": "expo export --platform android",
    "build:ios": "expo export --platform ios",
    "admin:dev": "npm --prefix admin run dev",
    "admin:build": "npm --prefix admin run build",
    "admin:start": "npm --prefix admin run start"
  },
  "dependencies": {
